{
  "name": "io-arena-android",
  "version": "1.0.0",
  "private": true,
  "description": "IO ARENA hub (Android via Capacitor + Windows via Electron)",
  "scripts": {
    "android:add": "cap add android && node scripts/patch-android.js && cap sync android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "win:start": "electron .",
    "win:build": "electron-builder --win --x64 --publish never",
    "remote:config": "node scripts/prepare.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "main": "electron/main.js",
  "author": "IO ARENA",
  "build": {
    "appId": "com.ioarena.hub",
    "productName": "IO ARENA",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IO ARENA",
      "artifactName": "IO-ARENA-Setup.${ext}"
    },
    "portable": {
      "artifactName": "IO-ARENA-Portable.${ext}"
    }
  }
}
